{
  "name": "@dunbar/base-template",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run web dev",
    "web": "bun --cwd packages/web",
    "ui": "bun --cwd packages/ui",
    "format": "bunx oxfmt",
    "nuke": "rm -rf packages/web/.alchemy",
    "typecheck": "bun run --filter './packages/*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "oxfmt": "0.76.0",
    "typescript": "catalog:"
  },
  "catalog": {
    "@orpc/client": "2.0.0-beta.50",
    "@orpc/contract": "2.0.0-beta.50",
    "@orpc/openapi": "2.0.0-beta.50",
    "@orpc/server": "2.0.0-beta.50",
    "@orpc/tanstack-query": "2.0.0-beta.50",
    "@orpc/zod": "2.0.0-beta.50",
    "hono": "4.13.16",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/router-plugin": "1.168.48",
    "dayjs": "^1.11.23",
    "@types/bun": "^1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16",
    "drizzle-orm": "1.0.0-rc.5",
    "better-auth": "1.7.17"
  }
}
