{
  "name": "@dunbar/web-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev alchemy.run.ts --stage local",
    "deploy:dev": "alchemy deploy alchemy.run.ts --stage dev",
    "deploy:prod": "alchemy deploy alchemy.run.ts --stage prod",
    "db:generate:auth": "auth generate --config ./src/api/auth/server.ts --output ./src/db/auth.ts --yes",
    "db:generate": "bun run db:generate:auth && drizzle-kit generate --config src/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config src/db/drizzle.config.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.17",
    "@better-auth/drizzle-adapter": "1.7.17",
    "@better-auth/mcp": "1.7.17",
    "@better-auth/oauth-provider": "1.7.17",
    "@dunbar/shared-template": "workspace:*",
    "@dunbar/ui-template": "workspace:*",
    "@modelcontextprotocol/server": "catalog:",
    "@orpc/mcp": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pg": "8.22.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.85",
    "@alchemy.run/planetscale": "2.0.0-beta.85",
    "@cloudflare/workers-types": "5.20261104.1",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.2.1",
    "alchemy": "2.0.0-beta.85",
    "auth": "1.7.17",
    "drizzle-kit": "1.0.0-rc.5",
    "effect": "4.1.2",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.5"
  }
}
