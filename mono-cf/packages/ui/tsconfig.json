{
  "include": ["vite.config.ts", "src/**/*.ts", "src/**/*.tsx"],
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "resolvePackageJsonExports": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "paths": {
      "@dunbar/ui/*": ["./src/*"]
    },
    "noEmit": true
  }
}
