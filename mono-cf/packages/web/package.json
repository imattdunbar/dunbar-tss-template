{
  "name": "@dunbar/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev infra/alchemy.run.ts --stage local",
    "build": "vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "infra": "alchemy",
    "deploy:dev": "alchemy deploy infra/alchemy.run.ts --stage dev",
    "deploy:prod": "alchemy deploy infra/alchemy.run.ts --stage prod",
    "db:generate": "drizzle-kit generate --config src/db/config.ts",
    "db:studio:local": "zsh -ic 'local-studio sqlite --schema ../shared/db/schema.ts'",
    "db:studio:dev": "zsh -ic 'local-studio d1 853b9b0d-fccd-4d92-bf43-8d3a5170a189 --schema ../shared/db/schema.ts'",
    "db:studio:prod": "zsh -ic 'local-studio d1 27f8944a-e9b3-4ed0-960e-798620e6099c --schema ../shared/db/schema.ts'"
  },
  "dependencies": {
    "@dunbar/ui": "workspace:*",
    "@dunbar/shared": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@scalar/api-reference": "^1.66.1",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "alchemy": "2.0.0-beta.72",
    "drizzle-kit": "^0.31.10",
    "effect": "4.0.0-rc.112",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
