{
  "name": "dunbar-mono-template",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "web": "bun --cwd packages/web",
    "shared": "bun --cwd packages/shared",
    "format": "bun run prettier --write . --log-level silent",
    "typecheck": "bun run --parallel --filter './packages/*' typecheck"
  },
  "catalog": {
    "@tanstack/react-query": "^5.101.4",
    "dayjs": "^1.11.21",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "uuid": "^14.0.1",
    "typescript": "^7.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "prettier": {
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "semi": false,
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
