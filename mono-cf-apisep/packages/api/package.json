{
  "name": "@dunbar/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client/*": "./src/client/*.ts",
    "./server/*": "./src/server/*.ts",
    "./infra": "./alchemy.run.ts"
  },
  "scripts": {
    "dev": "alchemy dev alchemy.run.ts --stage local",
    "typecheck": "tsc --noEmit",
    "deploy:dev": "alchemy deploy alchemy.run.ts --stage dev",
    "deploy:prod": "alchemy deploy alchemy.run.ts --stage prod",
    "db:generate:auth": "better-auth generate --config src/server/auth.ts --output src/server/db/auth-schema.ts --yes",
    "db:generate": "bun run db:generate:auth && drizzle-kit generate --config src/server/db/config.ts",
    "db:studio:local": "zsh -ic 'local-studio sqlite --schema src/server/db/schema.ts'"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@tanstack/react-start": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "hono": "^4.13.4",
    "react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/cli": "catalog:",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@libsql/client": "^0.17.4",
    "@types/bun": "catalog:",
    "alchemy": "2.0.0-beta.72",
    "drizzle-kit": "^0.31.10",
    "effect": "4.0.0-rc.112",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
