{
  "name": "dunbar-mono-cf-template",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "init-project": "bun run init.ts",
    "dev": "bun run api dev",
    "api": "bun --cwd packages/api",
    "web": "bun --cwd packages/web",
    "shared": "bun --cwd packages/shared",
    "ui": "bun --cwd packages/ui",
    "format": "bun run prettier --write . --log-level silent",
    "typecheck": "bun run --parallel --filter '*' typecheck",
    "deploy:dev": "bun run api deploy:dev",
    "deploy:prod": "bun run api deploy:prod"
  },
  "catalog": {
    "@better-auth/cli": "^1.4.21",
    "@orpc/client": "2.0.0-beta.31",
    "@orpc/openapi": "2.0.0-beta.31",
    "@orpc/server": "2.0.0-beta.31",
    "@orpc/tanstack-query": "2.0.0-beta.31",
    "@orpc/zod": "2.0.0-beta.31",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.49",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "prettier": {
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "semi": false,
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
